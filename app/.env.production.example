# ──────────────────────────────────────────────────────────────────────────
# fitlo — PRODUCTION environment template.
#
# Paste these into the host's env panel (Chabokan / Liara / any Node service).
# `.env.example` is the *development* template — do not deploy that one.
#
# Anything marked __CHANGE_ME__ must be replaced before this goes live.
# The comments say what actually breaks when a value is wrong, so nothing here
# is cargo-culted.
#
# NB: NEXT_PUBLIC_* values are baked into the client bundle at BUILD time.
# Changing one needs a full rebuild — a restart is not enough.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
# `next start` sets this itself, but set it explicitly: two security behaviours
# hang off it. When it is NOT "production":
#   1. POST /api/auth/otp/request echoes the OTP back as `devCode` — meaning
#      anyone can sign in as any phone number, including an ADMIN one.
#   2. Auth cookies lose the `secure` flag and can travel over plain HTTP.
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/fitlo?schema=public

# ── Auth secrets — THE most important lines in this file ─────────────────
# These sign the access/refresh JWTs. The development template ships literal
# placeholder strings ("dev_access_secret_change_me"), and that file is public
# in the repository: shipping it means anyone who reads the repo can mint a
# valid token for ANY user id, ADMIN included. That is a total auth bypass.
#
# Generate a fresh pair, each 32+ random bytes, never reused between the two:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating these logs everyone out (existing tokens stop verifying). That is
# the correct trade: do it once, now, rather than after a breach.
JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Public origin ─────────────────────────────────────────────────────────
# Canonical URLs, hreflang, sitemap, robots and OG tags all derive from this.
# Baked at build time. If it is missing or points at localhost, `lib/site.ts`
# refuses the loopback value during a production build and falls back to
# https://fitlo.ir while logging a warning on every prerendered page — that
# safety net is why a wrong value is loud instead of silently shipping
# "http://localhost:3000" as your canonical to Google.
NEXT_PUBLIC_SITE_URL=https://fitlo.ir

# Used server-side to build the ZarinPal return URL and the post-payment
# redirect back to /coach/billing. Left as localhost, a coach who pays is
# bounced to a dead address and the payment looks lost.
APP_PUBLIC_URL=https://fitlo.ir

# ── Object storage (S3 / MinIO) ───────────────────────────────────────────
# S3_ENDPOINT is used server-side; S3_PUBLIC_ENDPOINT is the host that presigned
# URLs are signed for and that the browser fetches. On a single public MinIO they
# are the same value. They differ only in local Docker, where the container sees
# `minio:9000` and the browser sees `localhost:9100`.
S3_ENDPOINT=https://minio.example.ir
S3_PUBLIC_ENDPOINT=https://minio.example.ir
S3_ACCESS_KEY=__CHANGE_ME__
S3_SECRET_KEY=__CHANGE_ME__
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# avatars / gifs / pdfs / videos must be public-read.
# `requests` holds student intake photos and payment receipts and MUST stay
# private — the coach inbox reads it through short-lived presigned GETs.
#
# `videos` is legacy: uploading clips was removed (a coach now pastes a YouTube
# or Aparat link instead). The bucket stays so clips uploaded before that still
# play, and so replacing/deleting such an exercise still cleans them up.
S3_BUCKET_AVATARS=avatars
S3_BUCKET_GIFS=gifs
S3_BUCKET_PDFS=pdfs
S3_BUCKET_REQUESTS=requests
S3_BUCKET_VIDEOS=videos

# ── PDF (Puppeteer) ───────────────────────────────────────────────────────
# LEAVE BLANK on a managed Node host. Server-side rendering needs a real browser
# — not just the Chrome binary but the ~15 system libraries it links against,
# which cannot be installed without root — so a plain Node service will never
# have one. That is expected and handled: the PDF endpoint returns 503
# PDF_UNAVAILABLE and the download button falls back to
# /api/{coach,student}/programs/<id>/print, which serves the very same RTL
# document as HTML and lets the reader's own browser print it to PDF.
#
# Set this (or deploy the Dockerfile's `production` target, which installs
# chromium + fonts) only if you want server-rendered, cached PDF files. When the
# path does not exist on disk it is ignored rather than fatal.
PUPPETEER_EXECUTABLE_PATH=

# ── OTP / SMS ─────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# "smsir" in production. "mock" only logs the code and must never ship.
SMS_PROVIDER=smsir
SMSIR_API_KEY=__CHANGE_ME__
SMSIR_TEMPLATE_ID=__CHANGE_ME__
SMSIR_PARAM_NAME=Code

# ── Email (not used for auth; safe to leave on mock) ──────────────────────
EMAIL_PROVIDER=mock
EMAIL_FROM=support@fitlo.ir
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Payments ──────────────────────────────────────────────────────────────
# Blank merchant id → the in-app simulate flow. Correct while public pricing is
# still "coming soon". Before charging real money: fill the merchant id AND set
# ZARINPAL_SANDBOX=false, then test once with a minimal real amount.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Stripe is disabled for new checkout; the keys stay for historical rows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Platform owner ────────────────────────────────────────────────────────
# Comma-separated. Signing in with one of these phones creates or promotes the
# account to ADMIN — there is no admin signup UI. Migration
# `20260722020000_seed_admin_owner` seeds +989356995806 as the owner, so keep
# that number here or login-time owner detection disagrees with the database.
ADMIN_PHONES=+989356995806

# ── Optional ──────────────────────────────────────────────────────────────
# Google Search Console verification token (rendered into the page head).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ──────────────────────────────────────────────────────────────────────────
# NOT needed here. POSTGRES_*, MINIO_*, APP_PORT and POSTGRES_PORT belong to
# docker-compose, which uses them to *create* the local containers. A managed
# host already gave you DATABASE_URL and the S3 credentials, so those variables
# do nothing on the server except invite confusion.
#
# COOKIE_DOMAIN is likewise unnecessary: it is declared in `server/config.ts`
# but read nowhere in the codebase — cookies are issued without an explicit
# domain, which is the correct behaviour for a single-origin app.
# ──────────────────────────────────────────────────────────────────────────
