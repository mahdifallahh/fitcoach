# ──────────────────────────────────────────────────────────────────────────
# fitlo — single Next.js app environment (native dev).
# The app serves both the UI and /api/* Route Handlers, so there is one env.
# For native dev:  cp .env.example .env.local  (point at host-published infra)
# Under Docker Compose these come from the root .env / compose env_file.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Database (host-published Docker Postgres; remap the port if 5432 is taken)
DATABASE_URL=postgresql://fitcoach:fitcoach_dev_pw@localhost:5432/fitcoach?schema=public

# Object storage (MinIO locally; AWS S3 in prod — same code path)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AVATARS=avatars
S3_BUCKET_GIFS=gifs
S3_BUCKET_PDFS=pdfs
S3_BUCKET_REQUESTS=requests
S3_BUCKET_VIDEOS=videos

# Exercise video upload + ffmpeg compression.
# NEXT_PUBLIC_ because the browser enforces the same ceiling before uploading;
# the server re-checks it (a client-side limit is a courtesy, not a control).
NEXT_PUBLIC_VIDEO_MAX_UPLOAD_MB=100
# Optional - auto-detected from PATH / the usual install locations when unset.
FFMPEG_PATH=
FFPROBE_PATH=
# Quality/size trade-off: lower CRF = better + bigger. 26-28 suits demo clips.
VIDEO_CRF=28
VIDEO_PRESET=veryfast
VIDEO_MAX_WIDTH=1280
VIDEO_AUDIO_BITRATE_KBPS=96
VIDEO_TIMEOUT_MS=300000

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Auth / OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@fitlo.local

# Payments (blank → in-app simulate checkout)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PDF (Puppeteer). Optional — the path the Docker image provides. If it doesn't exist,
# the service auto-detects a locally installed Chrome / Chromium / Edge; only when
# nothing is found does the PDF endpoint degrade to a clean 503.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# App URL / cookies
APP_PUBLIC_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Canonical public origin for SEO (canonical URLs, sitemap, robots, OG tags).
# Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform owner phone numbers (comma-separated). Logging in with one of these
# makes the account ADMIN and opens the /admin panel. Set to YOUR phone.
ADMIN_PHONES=+989356995806

# SMS.ir (production OTP). Set SMS_PROVIDER=smsir and fill these; the template
# must be approved in the SMS.ir panel and contain the {Code} parameter.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM_NAME=Code
