# The deploy CLI uploads *this* directory, and it does not read the repository
# root's .gitignore one level up — so without this file it packs node_modules
# (~1.3 GB) and .next (~280 MB) and is rejected for exceeding the 100 MB limit,
# while the actual source is about 2 MB.
#
# Keep it in sync with the root .gitignore for anything under app/.

node_modules/
# pnpm's content-addressed cache — 2.5 GB here, and by far the largest thing in
# this directory. Easy to miss because nothing references it by name.
.pnpm-store/
.next/
out/
build/

# Local environment files. `.env.local` holds real development credentials and
# has no business on the production host; the two *.example templates are
# documentation and must stay.
.env
.env.local
.env.*.local

# Test + tooling output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.tsbuildinfo
*.log
